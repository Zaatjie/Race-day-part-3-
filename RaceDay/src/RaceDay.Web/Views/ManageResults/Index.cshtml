@model ResultsPageViewModel
@{ ViewData["Title"] = "Results"; }
<h1 class="rd-h2 mb-4">Results</h1>

@if (!Model.Events.Any())
{
    <partial name="_NoEvents" />
}
else
{
    await Html.RenderPartialAsync("_EventPicker", new EventPickerModel { Events = Model.Events, SelectedId = Model.Selected?.EventId, Controller = "ManageResults" });

    if (!Model.EventHasHappened)
    {
        <div class="alert alert-info">
            <i class="bi bi-hourglass-split"></i>
            Results can be captured once the event has taken place (@Model.Selected?.EventDate.ToString("d MMMM yyyy")).
        </div>
    }
    else if (!Model.Rows.Any())
    {
        <div class="rd-empty">
            <i class="bi bi-stopwatch"></i>
            <h2 class="rd-h3">Nobody to record results for</h2>
            <p>No participants are enrolled in this event.</p>
        </div>
    }
    else
    {
        <p class="rd-meta">Enter each participant's finish time (hh:mm:ss) and position, then publish. Published results show on the participant's My Results page straight away.</p>
        foreach (var group in Model.Rows.GroupBy(r => r.Enrolment.CategoryName))
        {
            <h2 class="rd-h3 mt-4 mb-2">@group.Key</h2>
            <div class="list-group rd-list">
                @foreach (var row in group)
                {
                    var res = row.Result;
                    <div class="list-group-item">
                        <form asp-action="Save" method="post" class="rd-result-row" novalidate>
                            <input type="hidden" name="EventId" value="@Model.Selected!.EventId" />
                            <input type="hidden" name="EnrolmentId" value="@row.Enrolment.EnrolmentId" />
                            @if (res is not null) { <input type="hidden" name="ResultId" value="@res.ResultId" /> }
                            <div class="rd-result-name">
                                <strong>@row.Enrolment.ParticipantName</strong>
                                @if (res is not null) { <div><partial name="_ResultBadge" model="res.Status" /> <small class="rd-meta">published</small></div> }
                            </div>
                            <div>
                                <label class="form-label small mb-0">Finish time</label>
                                <input name="FinishTime" class="form-control form-control-sm" placeholder="01:23:45"
                                       value="@(res is null ? "" : Display.Time(res.FinishTime))" pattern="([01]?[0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]" required />
                            </div>
                            <div>
                                <label class="form-label small mb-0">Position</label>
                                <input name="Position" type="number" min="0" class="form-control form-control-sm" value="@(res?.Position ?? 0)" required />
                            </div>
                            <div>
                                <label class="form-label small mb-0">Status</label>
                                <select name="Status" class="form-select form-select-sm">
                                    @foreach (var s in ResultStatuses.All)
                                    {
                                        <option value="@s" selected="@(res?.Status == s)">@s</option>
                                    }
                                </select>
                            </div>
                            <div class="align-self-end">
                                <button type="submit" class="btn btn-rd btn-sm">@(res is null ? "Publish" : "Update")</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        }
    }
}

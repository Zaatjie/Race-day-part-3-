@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show rd-alert" role="alert">
        <i class="bi bi-check-circle-fill"></i> @ok
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show rd-alert" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @err
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

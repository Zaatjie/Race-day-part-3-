@model EventDto
<div class="card rd-card h-100">
    @if (!string.IsNullOrEmpty(Model.BannerUrl))
    {
        <img src="@Model.BannerUrl" class="rd-card-banner" alt="Banner for @Model.EventName" />
    }
    else
    {
        <div class="rd-card-banner rd-banner-placeholder"><i class="bi @Display.TypeIcon(Model.EventType)"></i></div>
    }
    <div class="card-body d-flex flex-column">
        <span class="rd-chip mb-2"><i class="bi @Display.TypeIcon(Model.EventType)"></i> @Model.EventType · @Model.Distance.ToString("0.##") km</span>
        <h3 class="card-title rd-h3">@Model.EventName</h3>
        <p class="rd-meta mb-1"><i class="bi bi-calendar3"></i> @Model.EventDate.ToString("ddd, d MMM yyyy")</p>
        <p class="rd-meta mb-3"><i class="bi bi-geo-alt"></i> @Model.Location</p>
        <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-rd mt-auto">View event</a>
    </div>
</div>

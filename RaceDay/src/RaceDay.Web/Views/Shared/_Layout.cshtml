@{
    var session = Context.Session;
    var signedIn = session.IsSignedIn();
    var role = session.GetRole();
    var name = session.GetFullName();
    var picture = session.GetPictureUrl();
    var current = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "");
    var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "");
    string Active(params string[] controllers) => controllers.Contains(current) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "RaceDay") · RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
        <div class="container">
            <a class="navbar-brand rd-brand" href="@Url.Action(role == "Organiser" ? "Dashboard" : "Index", role == "Organiser" ? "Organiser" : "Home")">
                <i class="bi bi-flag-fill"></i> Race<span>Day</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    @if (role == "Organiser")
                    {
                        <li class="nav-item"><a class="nav-link @Active("Organiser")" asp-controller="Organiser" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @Active("ManageEvents")" asp-controller="ManageEvents" asp-action="Index"><i class="bi bi-calendar-event"></i> Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("ManageCategories")" asp-controller="ManageCategories" asp-action="Index"><i class="bi bi-tags"></i> Categories</a></li>
                        <li class="nav-item"><a class="nav-link @Active("ManageEnrolments")" asp-controller="ManageEnrolments" asp-action="Index"><i class="bi bi-people"></i> Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link @Active("ManageResults")" asp-controller="ManageResults" asp-action="Index"><i class="bi bi-stopwatch"></i> Results</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @Active("Home", "Events")" asp-controller="Home" asp-action="Index"><i class="bi bi-calendar-event"></i> Upcoming events</a></li>
                        if (role == "Participant")
                        {
                            <li class="nav-item"><a class="nav-link @(current == "Participant" && action == "Enrolments" ? "active" : "")" asp-controller="Participant" asp-action="Enrolments"><i class="bi bi-ticket-perforated"></i> My enrolments</a></li>
                            <li class="nav-item"><a class="nav-link @(current == "Participant" && action == "Results" ? "active" : "")" asp-controller="Participant" asp-action="Results"><i class="bi bi-trophy"></i> My results</a></li>
                        }
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center">
                    @if (signedIn)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Profile")" asp-controller="Profile" asp-action="Index">
                            @if (picture is not null) { <img src="@picture" alt="" class="rd-avatar-sm" /> } else { <i class="bi bi-person-circle"></i> }
                            @name <span class="badge rd-role-badge">@role</span></a></li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm ms-lg-2"><i class="bi bi-box-arrow-right"></i> Log out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @(action == "Login" ? "active" : "")" asp-controller="Account" asp-action="Login">Log in</a></li>
                        <li class="nav-item"><a class="btn btn-rd btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="container rd-main">
    <partial name="_Flash" />
    @RenderBody()
</main>

<footer class="rd-footer">
    <div class="container d-flex flex-wrap justify-content-between">
        <span><strong>RaceDay</strong> · Run it. Ride it. Own it.</span>
        <span>&copy; @DateTime.Now.Year RaceDay</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

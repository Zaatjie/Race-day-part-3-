@model EventFormViewModel
@{ ViewData["Title"] = "New event"; }
<a asp-action="Index" class="rd-back"><i class="bi bi-arrow-left"></i> My events</a>
<div class="card rd-card"><div class="card-body p-4">
    <h1 class="rd-h2 mb-4">Create an event</h1>
    <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
        <partial name="_EventForm" model="Model" />
        <button type="submit" class="btn btn-rd">Create event</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div></div>

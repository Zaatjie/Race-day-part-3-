@model EventFormViewModel
<div asp-validation-summary="All" class="alert alert-danger"></div>
<div class="row">
    <div class="col-md-8 mb-3">
        <label asp-for="EventName" class="form-label"></label>
        <input asp-for="EventName" class="form-control" required />
        <span asp-validation-for="EventName" class="text-danger small"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" type="date" class="form-control" value="@(Model.EventDate?.ToString("yyyy-MM-dd"))" required />
        <span asp-validation-for="EventDate" class="text-danger small"></span>
    </div>
</div>
<div class="mb-3">
    <label asp-for="Location" class="form-label"></label>
    <input asp-for="Location" class="form-control" required />
    <span asp-validation-for="Location" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4" maxlength="500"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select" asp-items="@(new SelectList(EventTypes.All))"></select>
        <span asp-validation-for="EventType" class="text-danger small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Distance" class="form-label"></label>
        <input asp-for="Distance" type="number" step="0.01" min="0.01" max="999.99" class="form-control" required />
        <span asp-validation-for="Distance" class="text-danger small"></span>
    </div>
</div>
<div class="mb-4">
    <label asp-for="BannerFile" class="form-label"></label>
    @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
    {
        <div class="mb-2"><img src="@Model.ExistingBannerUrl" class="rd-form-banner" alt="Current banner" /></div>
    }
    <input asp-for="BannerFile" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
    <div class="form-text">Optional. JPG, PNG or WEBP, up to 5 MB.@(string.IsNullOrEmpty(Model.ExistingBannerUrl) ? "" : " Choosing a new file replaces the current banner.")</div>
    <span asp-validation-for="BannerFile" class="text-danger small"></span>
</div>
<input type="hidden" asp-for="ExistingBannerUrl" />
